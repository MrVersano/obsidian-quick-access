{
  "name": "obsidian-quick-access",
  "version": "1.0.0",
  "description": "Jump to your vault from any app with a global shortcut, and press it again to go back.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": "MrVersano",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "monkey-around": "^3.0.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrVersano/obsidian-quick-access.git"
  }
}
